{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockforge.local/schemas/md_inputs_provenance_v1.schema.json",
  "title": "DockForge MD inputs row provenance v1",
  "type": "object",
  "required": [
    "schema_version",
    "method_version",
    "generated_at",
    "status",
    "tag",
    "engine",
    "pose_no",
    "affinity_kcal_mol",
    "pH",
    "net_charge",
    "charge_authority",
    "scientific_review",
    "consumer_profile",
    "receptor_protonation_performed",
    "row_fingerprint",
    "inputs",
    "chemistry_backend",
    "docking_provenance",
    "gates",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "md_inputs_provenance_v1"},
    "status": {"const": "completed"},
    "engine": {"enum": ["gnina", "vina", "smina"]},
    "pose_no": {"type": "integer", "minimum": 1},
    "pH": {"type": "number", "minimum": 0, "maximum": 14},
    "net_charge": {"type": "integer"},
    "charge_authority": {"enum": ["predicted", "human_approved"]},
    "scientific_review": {"enum": ["human_review_required", "completed"]},
    "consumer_profile": {"const": "charmm_gui_cgenff_v1"},
    "receptor_protonation_performed": {"const": false},
    "row_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object"},
    "docking_provenance": {"type": "object"},
    "gates": {"type": "object"},
    "outputs": {"type": "object"}
  }
}
